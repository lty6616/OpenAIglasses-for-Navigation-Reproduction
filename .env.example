# Copy this file to .env and fill in local values.
# Do not commit .env.

# DashScope / Qwen
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
QWEN_OMNI_MODEL=qwen3.5-omni-plus
QWEN_OMNI_TEST_MODEL=qwen3.5-omni-plus
QWEN_OMNI_TEST_PROMPT=请用中文简要描述这张图片，并说明是否有明显障碍物。
QWEN_OMNI_VOICE=Cherry
QWEN_OMNI_AUDIO_RATE=24000

# Local Paraformer / FunASR smoke tests
PARAFORMER_MODE=local
PARAFORMER_MODEL=paraformer-zh
PARAFORMER_VAD_MODEL=fsmn-vad
PARAFORMER_PUNC_MODEL=ct-punc
PARAFORMER_SERVER_URL=http://127.0.0.1:8000/v1/audio/transcriptions

# Model paths. Relative paths are resolved from this project directory.
BLIND_PATH_MODEL=model/yolo-seg.pt
OBSTACLE_MODEL=model/yoloe-11l-seg.pt
YOLOE_MODEL_PATH=model/yoloe-11l-seg.pt
TRAFFIC_LIGHT_MODEL=model/trafficlight.pt
SHOPPING_MODEL=model/shoppingbest5.pt
HAND_TASK_PATH=model/hand_landmarker.task
COCO_MODEL=model/yolov8l-world.pt

# Runtime device and performance controls
AIGLASS_DEVICE=cuda:0
AIGLASS_AMP=fp16
AIGLASS_GPU_SLOTS=1
AIGLASS_OBS_CONF=0.25
AIGLASS_OBS_INTERVAL=5
AIGLASS_BLINDPATH_INTERVAL=5
AIGLASS_CROSSWALK_INTERVAL=5
AIGLASS_DIRECTION_INTERVAL=5
AIGLASS_STRAIGHT_INTERVAL=2
AIGLASS_PANEL_SCALE=0.35
TRAFFIC_LIGHT_CONF=0.25

# Continuous traffic monitor shown on /status (lazy-loaded by the page control)
TRAFFIC_MONITOR_FPS=5
TRAFFIC_MONITOR_CONF=0.20
TRAFFIC_MONITOR_IMGSZ=640
TRAFFIC_MONITOR_JPEG_QUALITY=82

# Audio
VOICE_DIR=voice
MUSIC_DIR=music
ITEM_GUIDANCE_AUDIO_DIR=music
AIGLASS_COMPRESS_AUDIO=1
TTS_INTERVAL_SEC=1.0
ITEM_SEARCH_ENABLE_TTS=true
ITEM_SEARCH_TTS_INTERVAL_SEC=1.0
TRAFFIC_LIGHT_ENABLE_TTS=false
TRAFFIC_LIGHT_TTS_INTERVAL_SEC=2.0

# Optional debug/simulation switches
AIGLASS_DEBUG_TRAFFIC_LIGHT=0
AIGLASS_SIMULATE_TRAFFIC_LIGHT=0
ASR_DEBUG_RAW=0
